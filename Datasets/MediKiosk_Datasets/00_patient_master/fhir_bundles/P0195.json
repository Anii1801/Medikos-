    "code": {
     "text": "excessive thirst and frequent urination",
     "coding": [
      {
       "system": "http://hl7.org/fhir/sid/icd-10",
       "code": "E11.9"
      }
     ]
    },
    "note": [
     {
      "text": "74-year-old male presenting with excessive thirst and frequent urination for 3 weeks. Character: passing urine many times, also at night; radiation: n/a; aggravated by sweet food; relieved by nothing. Severity 7/10. Associated: tiredness. PMH: Type 2 diabetes for 11 years; Hypertension for 3 years; Coronary artery disease, stent 4 years ago. Drugs: Metformin 500 mg; Amlodipine 5 mg; Aspirin 75 mg; Atorvastatin 20 mg. Allergy: no known allergies. Family: diabetes. Personal: non-smoker, no alcohol. Triage: ROUTINE."
     }
    ]
   }
